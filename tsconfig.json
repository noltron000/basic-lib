{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"types": ["node"],
		"strict": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"rootDir": "./source",
		"outDir": "./build"
	},
	"include": ["source/**/*.mts"],
	"exclude": ["source/**/*.test.mts", "node_modules"]
}
